// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "global_shortcuts": {
      "toggle": "control+SPACE"
   },
   "font": {
      "normal": {
         "family": "JetBrainsMono Nerd Font",
         "size": 13
      }
   },
   "theme": {
      "dark": {
         "name": "dracula"
      }
   },
   "launcher_window": {
      "opacity": 0.3,
      "material": "liquid_glass"
   },
   "providers": {
      "@VladCuciureanu/store.raycast.toothpick": {
         "enabled": false,
         "preferences": {
            "fuzzyRatio": "98",
            "bluetoothBackend": "blueutil",
            "favoriteDevice1": "DarkPods Pro",
            "favoriteDevice2": "Logi Z407"
         },
         "entrypoints": {
            "connect-favorite-device-1": {
               "enabled": true,
               "shortcut": "super+control+alt+1"
            },
            "connect-favorite-device-2": {
               "enabled": true,
               "shortcut": "super+control+alt+2"
            },
            "connect-favorite-device-3": {
               "enabled": true,
               "shortcut": "super+control+alt+3"
            },
            "disconnect-favorite-device-1": {
               "enabled": true,
               "shortcut": "super+control+alt+4"
            },
            "disconnect-favorite-device-2": {
               "enabled": true,
               "shortcut": "super+control+alt+5"
            },
            "disconnect-favorite-device-3": {
               "enabled": true,
               "shortcut": "super+control+alt+6"
            },
            "manage-bluetooth-connections": {
               "alias": "blu"
            },
            "toggle-favorite-device-1": {
               "enabled": true,
               "shortcut": "super+control+alt+A"
            }
         }
      },
      "@appest/store.raycast.ticktick": {
         "enabled": true,
         "preferences": {
            "defaultTitle": "none",
            "defaultDate": "none"
         },
         "entrypoints": {
            "create": {
               "shortcut": "super+alt+shift+A"
            },
            "inbox": {
               "shortcut": "super+alt+shift+I"
            },
            "index": {
               "shortcut": "super+alt+shift+T"
            },
            "next7Days": {
               "shortcut": "super+alt+shift+7"
            },
            "quickAdd": {
               "shortcut": "super+alt+shift+Q"
            },
            "search": {
               "shortcut": "super+alt+shift+S"
            }
         }
      },
      "@benvp/store.raycast.audio-device": {
         "entrypoints": {
            "auto-switch-input": {
               "enabled": false
            },
            "auto-switch-output": {
               "enabled": false
            },
            "set-input-device": {
               "alias": "in",
               "shortcut": "control+alt+shift+I"
            },
            "set-input-volume": {
               "enabled": false
            },
            "set-output-device": {
               "alias": "out",
               "shortcut": "control+alt+shift+O"
            },
            "set-volume": {
               "enabled": false
            }
         }
      },
      "@g0d/store.raycast.time": {
         "entrypoints": {
            "index": {
               "alias": "time"
            }
         }
      },
      "@marcjulian/store.raycast.obsidian": {
         "preferences": {
            "configFileName": ".obsidian"
         },
         "entrypoints": {
            "createNoteCommand": {
               "alias": "crnote",
               "preferences": {
                  "blankNote": false,
                  "focusContentArea": true,
                  "openOnCreate": false,
                  "prefPath": "0.Inbox",
                  "prefNoteName": "Untitled",
                  "prefNoteContent": "",
                  "fillFormWithDefaults": false,
                  "prefTag": "",
                  "tags": "",
                  "folderActions": ""
               }
            },
            "searchNoteCommand": {
               "shortcut": "control+shift+O",
               "preferences": {
                  "showDetail": true,
                  "showMetadata": false,
                  "searchContent": false,
                  "fuzzySearch": false,
                  "primaryAction": "quicklook"
               }
            },
            "starredNotesCommand": {
               "shortcut": "control+shift+B"
            }
         }
      },
      "@mattisssa/store.raycast.spotify-player": {
         "entrypoints": {
            "devices": {
               "enabled": true,
               "shortcut": "super+control+A"
            },
            "findLyrics": {
               "enabled": true,
               "shortcut": "super+control+F"
            },
            "generatePlaylist": {
               "enabled": false
            },
            "like": {
               "enabled": true,
               "shortcut": "super+control+L"
            },
            "next": {
               "enabled": true,
               "shortcut": "super+control+ARROWRIGHT"
            },
            "nowPlaying": {
               "enabled": true,
               "shortcut": "super+control+N"
            },
            "previous": {
               "enabled": true,
               "shortcut": "super+control+ARROWLEFT"
            },
            "queue": {
               "enabled": true,
               "shortcut": "super+control+/"
            },
            "search": {
               "enabled": true,
               "shortcut": "super+control+S"
            },
            "togglePlayPause": {
               "enabled": true,
               "shortcut": "super+control+RETURN"
            },
            "volume": {
               "enabled": true,
               "shortcut": "super+control+="
            },
            "yourLibrary": {
               "enabled": true,
               "shortcut": "super+control+."
            }
         }
      },
      "@philip_chen/store.raycast.sidecar": {
         "preferences": {
            "ipadName": "iPad (Rader)"
         },
         "entrypoints": {
            "connect-sidecar": {
               "shortcut": "control+shift+I"
            }
         }
      },
      "@vimtor/store.raycast.video-downloader": {
         "preferences": {
            "downloadPath": "/Users/Artyom_1/Downloads Video",
            "homebrewPath": "/opt/homebrew/bin/brew",
            "autoLoadUrlFromClipboard": false,
            "autoLoadUrlFromSelectedText": false,
            "enableBrowserExtensionSupport": false,
            "forceIpv4": false,
            "cookiesFromBrowser": "none",
            "fastRemux": true
         },
         "entrypoints": {
            "index": {
               "alias": "youdl"
            }
         }
      },
      "applications": {
         "entrypoints": {
            "com.TickTick.task.mac": {
               "shortcut": "alt+P"
            },
            "com.apple.Passwords": {
               "alias": "pass"
            },
            "com.cron.electron": {
               "shortcut": "alt+C"
            },
            "com.google.GeminiMacOS": {
               "shortcut": "alt+G"
            },
            "com.hnc.Discord": {
               "shortcut": "alt+D"
            },
            "com.readdle.SparkDesktop": {
               "shortcut": "alt+S"
            },
            "com.spotify.client": {
               "shortcut": "alt+M"
            },
            "dev.warp.Warp-Stable": {
               "shortcut": "alt+W"
            },
            "dev.zed.Zed": {
               "shortcut": "alt+Z"
            },
            "md.obsidian": {
               "shortcut": "alt+O"
            },
            "net.imput.helium": {
               "shortcut": "alt+B"
            },
            "ru.keepcoder.Telegram": {
               "shortcut": "alt+T"
            }
         }
      },
      "core": {
         "entrypoints": {
            "search-emojis": {
               "shortcut": "super+control+alt+E"
            }
         }
      },
      "raycast-compat": {
         "entrypoints": {
            "store": {
               "preferences": {
                  "alwaysShowIntro": true
               }
            }
         }
      }
   }
}